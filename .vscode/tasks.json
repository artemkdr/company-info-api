{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/CompanyInfo.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/CompanyInfo.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/CompanyInfo.Api.csproj"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/src/CompanyInfo.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "restore",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/src/CompanyInfo.Api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--filter",
                "FullyQualifiedName~.Unit.",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "test:all",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "test:architecture",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--filter",
                "FullyQualifiedName~.Architecture.",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "test:integration",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--filter",
                "FullyQualifiedName~.Integration.",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "test-watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--filter",
                "FullyQualifiedName~.Unit.",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true,
            "group": "test"
        },
        {
            "label": "test-watch:all",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true,
            "group": "test"
        },
        {
            "label": "test-coverage",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/tests/CompanyInfo.Api.Tests.csproj",
                "--collect:\"XPlat Code Coverage\"",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "format",
            "command": "dotnet chsarpier",
            "type": "process",
            "args": [
                "format",
                "${workspaceFolder}/src/CompanyInfo.Api.csproj",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "format-solution",
            "command": "dotnet chsarpier",
            "type": "process",
            "args": [
                "format",
                "${workspaceFolder}/CompanyInfo.Api.sln",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
